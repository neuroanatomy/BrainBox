<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="description" content="open science neuroimaging collaboration neuroscience MRI">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.png" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/fonts/roboto/roboto.css" type="text/css">
</head>

<body>

<script type="text/html" id="template">
<Wrapper>
  <Header>
    <span class="title">BrainBox</span>
  </Header>
  <!-- the server's text, as it is: Vue does not compile it -->
  <main v-pre>
    <div class="ask-for-login">
      {{#message}}
      <h1>{{message}}</h1>
      {{#askToLogIn}}
      <p><a href="/auth/github">Log in</a> if you have access to it.</p>
      {{/askToLogIn}}
      {{/message}}
      {{^message}}
      <h1>Log in required</h1>
      <p>Please use your <a href="https://github.com">GitHub</a> account to log in.</p>
      <p>Logging in is required to {{functionality}}.</p>
      {{/message}}
    </div>
  </main>
  <Footer/>
</Wrapper>
</script>

<div id="app"></div>

<script>
const loggedUser = {{{loggedUser}}};
</script>
<script src="/js/ask-for-login-page.js"></script>
<script defer src="https://brainspell.pasteur.fr/umami/script.js" data-website-id="327bfb13-1a11-45f6-82d0-8b1306c5c4af"></script>
</body>
</html>
