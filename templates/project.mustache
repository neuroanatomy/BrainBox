<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="description" content="open science neuroimaging collaboration neuroscience MRI">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0"> 
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.png" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/fonts/roboto/roboto.css" type="text/css">
    <link rel="stylesheet" href="/lib/nwl-components/fonts.css">
</head>

<body>

<div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:stretch">
    
    <!-- nwl-components' Header, mounted by project-page.js (a Vue app of its own, outside the
         viewer); its title, the project's name, is projectInfo.name, set as text -->
    <div id="bb-header-app" class="bb-nwl"></div>
    
    <!-- Content -->
    <div id="content" style="flex:1 1 auto;position:relative">
        <div style="display:flex;width:100%;height:100%;align-items:stretch;position:absolute">

            <div id="left" style="flex:0 0 400px;position:relative">
            
                <div style="display:flex;flex-direction:column;height:100%">
                    <!-- Tools -->
                    <div id="tools" class="block" style="flex:1 0 0">
                    </div>
                
                    <!-- Project Files -->
                    <div id="projectFiles" class="block" style="flex:1 1 auto">
                        <table style="width:100%;text-align:left">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>File</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                
                    <!-- File Annotations -->
                    <div id="annotations" class="block" style="flex:1 1 200px">
                        <table id="volAnnotations" style="width:100%;text-align:left">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Label Set</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <div id="resizeButton" class="block">
                </div>
                
            </div>
            
            <div id="right" style="flex:1 0;position:relative">
                <!-- AtlasMaker -->
                <div id="stereotaxic" style="width:100%;height:100%">
                <!-- End of AtlasMaker -->
                </div>
            </div>

        </div>
    </div>
</div>

<script>
const projectInfo={{{projectInfo}}};
const annotationsAccessLevel='{{{annotationsAccessLevel}}}';
const loggedUser = {{{loggedUser}}};
const infoProxy = {};
</script>
<script src="/lib/atlasmaker.js"></script>
<script src="/lib/brainbox.js"></script>
<script src="/js/project-page.js"></script>

<script defer src="https://brainspell.pasteur.fr/umami/script.js" data-website-id="327bfb13-1a11-45f6-82d0-8b1306c5c4af"></script>

</body>
</html>
