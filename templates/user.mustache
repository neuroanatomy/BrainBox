<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="description" content="open science neuroimaging collaboration neuroscience MRI">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0"> 
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.png" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/fonts/roboto/roboto.css" type="text/css">
</head>

<body>

<script type="text/html" id="template">
<UserPage :user='{{{userInfo}}}'>
    <template v-slot:side>
        [[projects.length]] Projects
    </template>
    <template v-slot:content>
        <Tabs>
            <Tab title="Projects">
                <Table id="projects">
                    <thead>
                        <tr>
                            <sortable-th :sort="sort" column="Name">Name</sortable-th>
                            <sortable-th :sort="sort" column="Files">Files</sortable-th>
                            <sortable-th :sort="sort" column="Collaborators">Collaborators</sortable-th>
                            <sortable-th :sort="sort" column="Owner">Owner</sortable-th>
                            <sortable-th :sort="sort" column="Last modified">Last modified</sortable-th>
                        </tr>
                    </thead>
                    <tbody>
                    <tr v-for="project in sortedProjects">
                        <td>
                            <a :href="`${project.projectURL}/settings`" class="settings">
                                <img style="width:11px; margin:3px 8px 0 0" src="/img/settings.svg"/>
                            </a>
                            <a :href="project.projectURL">
                                [[project.shownName]]
                            </a>
                        </td>
                        <td>[[project.numFiles]]</td>
                        <td>[[project.numCollaborators]]</td>
                        <td>
                            <a :href="`/user/${project.owner}`">
                                [[project.owner]]
                            </a>
                        </td>
                        <td :title="localDate(project.modified, true) || null">[[localDate(project.modified)]]</td>
                    </tr>
                    </tbody>
                </Table>
            </Tab>
        </Tabs>
    </template>
</UserPage>
</script>
<style>
#projects {
    table-layout: auto;
}
#projects a {
    text-decoration: none;
}
.settings {
    opacity: 0.5;
    transition: opacity 500ms;
}
.settings:hover {
    opacity: 1;
}
</style>

<div id="app"></div>

<script>
const nickname = '{{nickname}}';
const loggedUser = {{{loggedUser}}};
</script>
<script src='/js/user-page.js'></script>

<script defer src="https://brainspell.pasteur.fr/umami/script.js" data-website-id="327bfb13-1a11-45f6-82d0-8b1306c5c4af"></script>

</body>
</html>
