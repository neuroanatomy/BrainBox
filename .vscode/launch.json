{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "run server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/bin/www",
            "env": {
                "NODE_ENV": "production"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "debug frontend",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}",
            "sourceMapPathOverrides": {
                "webpack://AtlasMakerWidget/*": "${workspaceFolder}/*",
                "webpack://BrainBox/*": "${workspaceFolder}/*",
                "webpack://*": "${workspaceFolder}/*"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "run tests",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/node_modules/mocha/bin/mocha",
            "args": [
                "./test/runner.js",
                "test/unit/*.js",
                "test/integration/*.js",
                "--no-timeout"
            ],
            "env": {
                "LOCALSIGNIN": "true",
                "MONGODB": "127.0.0.1:27017/brainbox_test"
            }
        }
    ]
}
